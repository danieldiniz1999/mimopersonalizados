# Supabase Configuration
# Preencha com os dados do seu projeto Supabase no Dashboard da Vercel (Project Settings > Environment Variables)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# SSR Fallbacks
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_PROJECT_ID="your-project-id"

# Segurança do Painel Administrativo (/admin)
# Configure suas próprias credenciais fortes na Vercel (Environment Variables)
ADMIN_USER="admin"
ADMIN_PASSWORD="coloque-uma-senha-forte-aqui"
ADMIN_SESSION_SECRET="coloque-um-secret-aleatorio-para-assinar-tokens-de-sessao"
